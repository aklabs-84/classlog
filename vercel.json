{
  "headers": [
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://mxzhienqaypsammvwssb.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "https://mxzhienqaypsammvwssb.supabase.co/functions/v1/mcp/.well-known/openid-configuration"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/gallery-upload/:token",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(kakaotalk|KAKAOTALK|Kakaotalk|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|Discordbot|WhatsApp|LinkedInBot|Line/).*" }],
      "destination": "/og/gallery-upload.html"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{1,5}$).*)",
      "destination": "/index.html"
    }
  ]
}
